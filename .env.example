# CPA LOCAL TEMPLATE ONLY — not consumed by an application yet.
# No production/staging endpoints, credentials or real client data.
# Copy only to a new local .env after configuration choices are approved.
# Empty required values are intentionally unresolved, never unlimited/zero-cost.
# Future application code must reject missing configuration before affected actions.
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=
FRONTEND_ORIGIN=
AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
STORAGE_BUCKET=
MAX_AI_RUN_COST=
# B019 validates an explicitly supplied mapping; this file is not auto-loaded.
# Live AI remains disabled even if set true with otherwise complete settings.
LIVE_AI_ENABLED=false
